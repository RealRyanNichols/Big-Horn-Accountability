# Public intake remains closed unless both server-only values are configured.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# At least 32 random characters. Server-only; used to create subject-scoped HMAC
# digests for aggregate visit deduplication. Never prefix with NEXT_PUBLIC_.
VIEW_COUNTER_HASH_SECRET=

# Set to "true" only after moderation staffing, privacy language, and retention
# controls are approved.
INTAKE_ENABLED=false
